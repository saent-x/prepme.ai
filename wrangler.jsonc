{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prepme",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Output of @sveltejs/adapter-cloudflare (vite build)
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "observability": { "enabled": true },
  // Served on the studio domain; the workers.dev URL stays on for previews.
  "routes": [{ "pattern": "prepme.stbrn.studio", "custom_domain": true }],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prepme",
      "database_id": "36e981b5-e28c-4d4c-9818-c7b9802f03c7",
      "migrations_dir": "drizzle"
    }
  ],
  // Non-secret settings. Secrets (OPENAI_API_KEY, BETTER_AUTH_SECRET, POLAR_ACCESS_TOKEN,
  // ADMIN_EMAILS, social client secrets) are set with `wrangler secret put` or in the dashboard,
  // and in .dev.vars for local development.
  "vars": {
    "BETTER_AUTH_URL": "https://prepme.stbrn.studio",
    "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe",
    "OPENAI_ANALYSIS_MODEL": "gpt-6-luna",
    "OPENAI_CHAT_MODEL": "gpt-6-luna",
    // Trimming for long calls. "0" = off. A number such as "8000" drops the oldest half of a
    // call once it passes that many tokens. Compare the result on /dashboard/costs before keeping it.
    "OPENAI_REALTIME_CONTEXT_TOKENS": "0",
    "POLAR_SERVER": "production",
    "UNLIMITED_USAGE": "false"
  },
  // Branch previews (`wrangler preview`, run by Workers Builds on every non-main branch).
  // They use their own database so a preview can never touch live data. Secrets for previews
  // are set separately with `wrangler preview secret put` or in the dashboard.
  "previews": {
    "vars": {
      // Empty on purpose: each preview has its own URL, so auth reads it from the request.
      "BETTER_AUTH_URL": "",
      "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
      "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe",
      "OPENAI_ANALYSIS_MODEL": "gpt-6-luna",
      "OPENAI_CHAT_MODEL": "gpt-6-luna",
      "OPENAI_REALTIME_CONTEXT_TOKENS": "0",
      "POLAR_SERVER": "sandbox",
      "UNLIMITED_USAGE": "false"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "prepme-preview",
        "database_id": "2321f78c-047a-4e56-a477-4634533b59e1"
      }
    ]
  }
}
