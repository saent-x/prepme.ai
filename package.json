{
  "name": "prepme",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "deploy": "vite build && wrangler d1 migrations apply prepme --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply prepme --local",
    "db:migrate": "wrangler d1 migrations apply prepme --remote",
    "cf:types": "wrangler types --include-runtime=false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@internationalized/date": "^3.10.0",
    "@lucide/svelte": "^1.77.0",
    "@sveltejs/adapter-cloudflare": "7.2.10",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.7",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@polar-sh/better-auth": "^2.1.5",
    "@polar-sh/sdk": "^1.3.2",
    "better-auth": "^1.7.27",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "mode-watcher": "^1.1.0",
    "nanoid": "^5.1.5",
    "openai": "^7.62.0",
    "svelte-exmarkdown": "^5.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
