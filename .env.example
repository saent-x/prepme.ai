# --- Database (Neon or any Postgres) ---
DATABASE_URL="postgres://user:password@host:5432/prepme"

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:5173"
# Social sign-in is optional: a provider only shows up when both values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- OpenAI (the only AI provider) ---
OPENAI_API_KEY=
# Live voice interviewer. gpt-realtime-mini is the cheap default; set gpt-realtime for the full model.
OPENAI_REALTIME_MODEL="gpt-realtime-mini"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
# Post-interview scorecard and the follow-up chat.
OPENAI_ANALYSIS_MODEL="gpt-5.6-luna"
OPENAI_CHAT_MODEL="gpt-5.6-luna"

# --- Billing (Polar, optional) ---
# Leave POLAR_ACCESS_TOKEN empty to run without billing (free-tier limits still apply).
POLAR_ACCESS_TOKEN=
POLAR_SERVER="sandbox"   # sandbox | production
# Set to "true" to lift the free-tier limits, e.g. for your own deployment.
UNLIMITED_USAGE="false"
